{
  "name": "@restate-pi/example-approval",
  "version": "0.1.0",
  "private": true,
  "description": "A pi agent whose production deploys wait, suspended, for a human to approve them",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=restate-pi-source src/app.ts",
    "start": "tsx src/app.ts",
    "typecheck": "tsc -b && tsc -p test",
    "test": "tsx --conditions=restate-pi-source --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@restatedev/restate-sdk": "^1.17.2",
    "@restatedev/restate-sdk-gen": "^1.17.2",
    "restate-pi": "workspace:*",
    "typebox": "^1.3.33"
  },
  "devDependencies": {
    "@restatedev/restate-sdk-testcontainers": "^1.17.2",
    "testcontainers": "^11.14.0"
  }
}
