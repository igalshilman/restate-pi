{
  "name": "@restate-pi/example-virtual-object",
  "version": "0.1.0",
  "private": true,
  "description": "pi inside Restate virtual objects: piAgent, piHarness and piCoding, built on restate-pi",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=restate-pi-source src/app.ts",
    "start": "tsx src/app.ts",
    "typecheck": "tsc -b && tsc -p test",
    "test": "tsx --conditions=restate-pi-source --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@restatedev/restate-sdk": "^1.17.2",
    "@restatedev/restate-sdk-gen": "^1.17.2",
    "restate-pi": "workspace:*",
    "typebox": "^1.3.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@restatedev/restate-sdk-testcontainers": "^1.17.2",
    "testcontainers": "^11.14.0"
  }
}
