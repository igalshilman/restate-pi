{
  "name": "restate-pi",
  "version": "0.1.0",
  "description": "Run pi, the open-source coding agent, inside Restate durable execution: agent sessions as virtual objects, tools as Restate operations, durable model calls and steering",
  "keywords": [
    "restate",
    "durable-execution",
    "pi",
    "pi-agent",
    "ai-agents",
    "coding-agent",
    "llm",
    "agent",
    "workflow",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "author": "Igal Shilman",
  "homepage": "https://github.com/igalshilman/restate-pi/tree/main/libs/restate-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igalshilman/restate-pi.git",
    "directory": "libs/restate-pi"
  },
  "bugs": {
    "url": "https://github.com/igalshilman/restate-pi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "restate-pi-source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p test",
    "test": "tsx --test test/*.test.ts",
    "prepack": "tsc -b --force"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@restatedev/restate-sdk": "^1.17.2",
    "@restatedev/restate-sdk-gen": "^1.17.2",
    "typebox": "^1.3.33"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@restatedev/restate-sdk": "^1.17.2",
    "@restatedev/restate-sdk-gen": "^1.17.2",
    "typebox": "^1.3.33"
  }
}
