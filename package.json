    "build": "tsc"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.17.1",
    "@restatedev/restate-sdk-gen": "^1.17.1",
    "openai": "^7.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  }
}
